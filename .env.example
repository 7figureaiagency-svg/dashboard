# Existing Supabase config lives in .env — copy the lines below into .env
# (or your hosting provider's env settings) once you have real Meta values.
# See SETUP.md for exactly how to obtain each one.

# --- Meta (Facebook) app — used for "Continue with Facebook" login and for
# --- WhatsApp Embedded Signup. Server-side secret, never exposed to the browser.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
# Shared webhook URL your n8n instance exposes for ALL clients' WhatsApp
# messages (Meta sends one payload per phone_number_id; n8n/your backend
# resolves which client_id it belongs to via clients.phone_number_id).
META_WEBHOOK_URL=https://n8n.yourdomain.com/webhook/meta-whatsapp

# --- Same app id/config id, exposed to the browser (Vite requires the
# --- VITE_ prefix for anything read client-side).
VITE_META_APP_ID=
VITE_META_CONFIG_ID=
VITE_META_GRAPH_VERSION=v21.0

# Base URL used to pre-fill suggested portal webhook URLs in the
# "Lead Sources & WhatsApp" tab (99acres/Housing/MagicBricks/...).
VITE_N8N_WEBHOOK_BASE_URL=https://n8n.yourdomain.com/webhook
